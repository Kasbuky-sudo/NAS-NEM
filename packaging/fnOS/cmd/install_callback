#!/bin/bash

### 安装后：准备数据目录
### 数据不落 @appcenter（升级会整体覆盖），落 ${TRIM_PKGVAR}/data

set -e

mkdir -p "${TRIM_PKGVAR}/data"
chown -R "${TRIM_USERNAME}:${TRIM_GROUPNAME}" "${TRIM_PKGVAR}" 2>/dev/null || true

### 下载音乐落地目录：NAS 用户根目录下的「网易云音乐」
### /vol1/1000 是 fnOS 主用户（uid 1000）的家目录，应用进程以 ${TRIM_USERNAME}
### 身份运行、没权在家目录里建目录 —— 这里以 root 预建并把属主交给应用用户。
### 服务端（src/config.js resolveDownloadDir）检测到 /vol1/1000 就会用它。
if [ -d "/vol1/1000" ]; then
    if [ ! -e "/vol1/1000/网易云音乐" ]; then
        mkdir -p "/vol1/1000/网易云音乐" || true
    fi
    if [ -d "/vol1/1000/网易云音乐" ]; then
        chown "${TRIM_USERNAME}:${TRIM_GROUPNAME}" "/vol1/1000/网易云音乐" 2>/dev/null || true
        chmod 755 "/vol1/1000/网易云音乐" 2>/dev/null || true
        echo "下载目录已就绪: /vol1/1000/网易云音乐 (owner=${TRIM_USERNAME})" >> "${TRIM_TEMP_LOGFILE}"
    fi
fi

echo "数据目录已就绪: ${TRIM_PKGVAR}/data" >> "${TRIM_TEMP_LOGFILE}"
exit 0
